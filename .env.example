# Valores reales: configurar en Railway o en un .env local ignorado por Git.
PORT=3000
CHATFUEL_BOT_ID=
CHATFUEL_API_TOKEN=
CHATFUEL_BOOKING_SECRET=
# Identificadores propios; bitrixUserId corresponde al calendario del asesor.
APPOINTMENT_ADVISORS_JSON=[{"id":"asesor-1","name":"Asesor","bitrixUserId":"123"}]
CHATFUEL_BOOKING_FLOW_ID=
APPOINTMENT_SAME_DAY_CUTOFF_HOUR=12
# Mantener false al preparar otro servicio; activar al realizar el cambio.
HANDOFF_SYNC_ENABLED=false
INCOMING_RECOVERY_ENABLED=false

# Registro de clientes en la misma API; MySQL permanece en su servicio aparte.
MYSQL_URL=mysql://usuario:clave@mysql.railway.internal:3306/chatfuel
BITRIX_WEBHOOK_URL=https://tu-portal.bitrix24.com/rest/1/TU_WEBHOOK/
# Opcional si el webhook anterior ya tiene permisos calendar; mismo portal.
BITRIX_CALENDAR_WEBHOOK_URL=
REGISTRAR_CLIENTE_TOKEN=

# Seguimientos: mantener desactivados hasta vincular y probar las plantillas.
FOLLOWUPS_ENABLED=false
FOLLOWUPS_TEMPLATES_APPROVED=false
FOLLOWUPS_ENROLL_AFTER=
WASAPI_API_KEY=
# Prefijo WhatsApp de este bot (wa_<id>_<id>_), verificado en los contactos.
FOLLOWUPS_CHATFUEL_CONTACT_PREFIX=
# IDs verificados de Carol y Tatiana, separados por coma.
FOLLOWUPS_SETTER_IDS=
FOLLOWUPS_TARGET_STAGE_ID=C370:UC_4N24TP
FOLLOWUPS_DALIA_STAGE_ID=C370:PREPARATION
FOLLOWUPS_1H_TEMPLATE_NAME=seguimiento_rch_1_hora
FOLLOWUPS_24H_TEMPLATE_NAME=seguimiento_rch_24_horas
FOLLOWUPS_72H_TEMPLATE_NAME=seguimiento_rch_72_horas
# Si los nombres difieren entre lineas, usar las referencias de cada una.
FOLLOWUPS_DALIA_1H_TEMPLATE_NAME=
FOLLOWUPS_DALIA_24H_TEMPLATE_NAME=
FOLLOWUPS_DALIA_72H_TEMPLATE_NAME=
FOLLOWUPS_CHATFUEL_1H_TEMPLATE_NAME=
FOLLOWUPS_CHATFUEL_24H_TEMPLATE_NAME=
FOLLOWUPS_CHATFUEL_72H_TEMPLATE_NAME=
# Solo para la prueba autorizada de botones sin inscribir negocios reales.
FOLLOWUPS_TEST_PHONES=
# URLs comunes solo si admiten elegir línea mediante fromId en el contrato.
FOLLOWUPS_1H_WEBHOOK_URL=
FOLLOWUPS_24H_WEBHOOK_URL=
FOLLOWUPS_72H_WEBHOOK_URL=
# Si cada automatización tiene una línea fija, usar los seis valores específicos.
FOLLOWUPS_DALIA_1H_WEBHOOK_URL=
FOLLOWUPS_DALIA_24H_WEBHOOK_URL=
FOLLOWUPS_DALIA_72H_WEBHOOK_URL=
FOLLOWUPS_CHATFUEL_1H_WEBHOOK_URL=
FOLLOWUPS_CHATFUEL_24H_WEBHOOK_URL=
FOLLOWUPS_CHATFUEL_72H_WEBHOOK_URL=
# Configurar el contrato real; no se presupone el cuerpo ni la respuesta del proveedor.
FOLLOWUPS_WEBHOOK_BODY_JSON=
# Ruta de un booleano true de aceptación, por ejemplo data.accepted.
FOLLOWUPS_WEBHOOK_ACCEPT_FIELD=
